        // ==================== ЗАДАЧИ И МИКРО-ШАГИ ====================
        function toggleStarTask(taskId) {
            if (state.starTaskId === taskId) {
                state.starTaskId = null; // убираем статус главного дела
            } else {
                state.starTaskId = taskId; // делаем главным делом
                triggerVibration('medium');
            }
            saveData();
            render();
        }

        function toggleSubtask(taskIndex, subIndex) {
            const task = state.tasks[taskIndex];
            task.subtasks[subIndex].done = !task.subtasks[subIndex].done;
            
            // Если все подзадачи выполнены - завершаем всю задачу
            const allSubDone = task.subtasks.every(st => st.done);
            if (allSubDone) {
                task.done = true;
                task.currentCount = task.targetCount || 1;
                triggerVibration('success');
            }
            saveData();
            render();
        }

        function incrementTaskCount(index) {
            const t = state.tasks[index];
            const target = t.targetCount || 1;
            let current = t.currentCount || 0;

            if (current < target) {
                current += 1;
            } else {
                current = 0;
            }

            t.currentCount = current;
            t.done = (current >= target);
            if (t.done && t.subtasks) {
                t.subtasks.forEach(st => st.done = true);
            }
            saveData();
            render();
            triggerVibration('light');
        }

        function incrementHabitCount(index) {
            const h = state.habits[index];
            const today = getTodayString();
            const target = h.targetCount || 1;

            if (h.lastCompletedDate !== today) {
                h.lastCompletedDate = today;
                h.todayCount = 0;
            }

            if (h.todayCount < target) {
                h.todayCount += 1;
                if (h.todayCount === target) {
                    h.streak += 1;
                    triggerVibration('medium');
                } else {
                    triggerVibration('light');
                }
            } else {
                h.todayCount = 0;
                h.streak = Math.max(0, h.streak - 1);
            }

            saveData();
            render();
        }

