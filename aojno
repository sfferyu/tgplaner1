        // ==================== ТАЙМЕР ФОКУСА (КАСТОМНЫЙ) ====================
        let timerMode = 'work'; // 'work' или 'break'
        let timerSeconds = 15 * 60;
        let timerTotalSeconds = 15 * 60;
        let timerInterval = null;

        function setTimerMode(mode) {
            timerMode = mode;
            const workMin = parseInt(document.getElementById('custom-work-min').value, 10) || 15;
            const breakMin = parseInt(document.getElementById('custom-break-min').value, 10) || 5;

            document.getElementById('btn-mode-work').className = (mode === 'work') 
                ? "px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#311B14] text-[#EDE6D8] transition"
                : "px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#311B14]/10 opacity-70 transition";
            
            document.getElementById('btn-mode-break').className = (mode === 'break') 
                ? "px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#311B14] text-[#EDE6D8] transition"
                : "px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#311B14]/10 opacity-70 transition";

            timerSeconds = (mode === 'work' ? workMin : breakMin) * 60;
            timerTotalSeconds = timerSeconds;
            
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                document.getElementById('timer-start-btn').innerText = "НАЧАТЬ";
            }
            updateTimerDisplay();
        }

        function updateTimerSettings() {
            setTimerMode(timerMode);
        }

        function toggleTimer() {
            const btn = document.getElementById('timer-start-btn');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                btn.innerText = "ПРОДОЛЖИТЬ";
            } else {
                btn.innerText = "ПАУЗА";
                triggerVibration('medium');
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        updateTimerDisplay();
                    } else {
                        clearInterval(timerInterval);
                        timerInterval = null;
                        btn.innerText = "НАЧАТЬ";
                        triggerVibration('success');
                        alert(timerMode === 'work' ? "Время работы вышло! Сделай заслуженный перерыв ☕️" : "Перерыв окончен! Готова к новым победам? ✨");
                        setTimerMode(timerMode === 'work' ? 'break' : 'work');
                    }
                }, 1000);
            }
        }

        function resetTimer() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
            document.getElementById('timer-start-btn').innerText = "НАЧАТЬ";
            setTimerMode(timerMode);
        }

        function updateTimerDisplay() {
            const m = Math.floor(timerSeconds / 60);
            const s = timerSeconds % 60;
            document.getElementById('timer-display').innerText = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;

            // Прогресс круга (длина 440)
            const circle = document.getElementById('timer-progress');
            const fraction = timerSeconds / timerTotalSeconds;
            const offset = 440 * (1 - fraction);
            circle.style.strokeDashoffset = offset;
        }

