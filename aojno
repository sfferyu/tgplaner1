<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tout est devant soi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { 
            background-color: #EDE6D8; 
            color: #311B14; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        .title-font { 
            font-family: 'Times New Roman', Times, serif; 
            font-style: italic; 
            letter-spacing: 0.05em;
        }

        .tab-active { 
            border-bottom: 2px solid #311B14; 
            color: #311B14; 
            font-weight: 600; 
        }

        .tab-inactive {
            color: #8C7A70;
        }

        .hidden { display: none !important; }

        .card {
            background-color: #F5F0E6;
            border: 1px solid rgba(49, 27, 20, 0.1);
            border-radius: 16px;
            transition: all 0.2s ease;
        }

        .card-star {
            background-color: #F8F3EA;
            border: 1.5px solid rgba(49, 27, 20, 0.25);
            box-shadow: 0 4px 14px rgba(49, 27, 20, 0.08);
        }

        .custom-checkbox {
            appearance: none;
            width: 22px;
            height: 22px;
            border: 2px solid #311B14;
            border-radius: 6px;
            outline: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .custom-checkbox:checked {
            background-color: #311B14;
        }

        .custom-checkbox:checked::after {
            content: "✓";
            color: #EDE6D8;
            font-size: 13px;
            font-weight: bold;
        }

        .sub-checkbox {
            appearance: none;
            width: 16px;
            height: 16px;
            border: 1.5px solid #311B14;
            border-radius: 4px;
            outline: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

        .sub-checkbox:checked {
            background-color: #311B14;
        }

        .sub-checkbox:checked::after {
            content: "✓";
            color: #EDE6D8;
            font-size: 10px;
            font-weight: bold;
        }

        /* Настроение */
        .mood-circle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            box-shadow: 0 2px 6px rgba(49, 27, 20, 0.08);
        }

        .mood-circle:active {
            transform: scale(0.92);
        }

        .mood-selected {
            transform: scale(1.15) !important;
            box-shadow: 0 4px 12px rgba(49, 27, 20, 0.25) !important;
            border: 2.5px solid #311B14 !important;
        }

        .counter-pill {
            background-color: #EDE6D8;
            border: 1px solid rgba(49, 27, 20, 0.15);
            border-radius: 9999px;
            padding: 2px 8px;
            font-size: 11px;
            font-weight: 600;
        }

        /* Таймер Фокуса */
        .timer-circle-wrap {
            position: relative;
            width: 160px;
            height: 160px;
            margin: 0 auto;
        }

        .timer-circle-svg {
            transform: rotate(-90deg);
        }

        .timer-circle-bg {
            fill: none;
            stroke: rgba(49, 27, 20, 0.1);
            stroke-width: 6;
        }

        .timer-circle-progress {
            fill: none;
            stroke: #311B14;
            stroke-width: 6;
            stroke-linecap: round;
            transition: stroke-dashoffset 0.5s linear;
        }
    </style>
</head>
<body class="min-h-screen pb-28">
    <div class="max-w-md mx-auto p-4 flex flex-col min-h-screen justify-between">
        
        <div>
            <!-- Шапка -->
            <header class="pt-4 pb-2 text-center">
                <h1 class="text-4xl title-font mb-1.5">Tout est devant soi</h1>
                <p id="current-date" class="text-[11px] uppercase tracking-widest opacity-60"></p>
            </header>

            <!-- Прогресс дня -->
            <div id="progress-container" class="mb-4 px-1">
                <div class="flex justify-between text-[11px] opacity-70 mb-1">
                    <span>Прогресс дня</span>
                    <span id="progress-percent">0%</span>
                </div>
                <div class="w-full bg-[#311B14]/10 h-[3px] rounded-full overflow-hidden">
                    <div id="progress-bar" class="bg-[#311B14] h-full transition-all duration-500" style="width: 0%"></div>
                </div>
            </div>

            <!-- Навигация (6 вкладок с аккуратной версткой) -->
            <nav class="flex justify-between items-center border-b border-[#311B14]/10 mb-5 text-center px-1">
                <button onclick="switchTab('tasks')" id="tab-tasks" class="pb-2.5 px-1 text-[11px] uppercase tracking-wider tab-active">Задачи</button>
                <button onclick="switchTab('habits')" id="tab-habits" class="pb-2.5 px-1 text-[11px] uppercase tracking-wider tab-inactive">Привычки</button>
                <button onclick="switchTab('schedule')" id="tab-schedule" class="pb-2.5 px-1 text-[11px] uppercase tracking-wider tab-inactive">День</button>
                <button onclick="switchTab('focus')" id="tab-focus" class="pb-2.5 px-1 text-base tab-inactive transition-all" title="Фокус">⏱️</button>
                <button onclick="switchTab('sleep')" id="tab-sleep" class="pb-2.5 px-1 text-base tab-inactive transition-all" title="Сон и мысли">🌙</button>
                <button onclick="switchTab('mood')" id="tab-mood" class="pb-2.5 px-1 text-base tab-inactive transition-all" title="Галерея">🤍</button>
            </nav>

            <!-- Контент -->
            <main>
                <!-- 1. ЗАДАЧИ -->
                <div id="section-tasks" class="space-y-3">
                    <!-- Блок Главной Победы Дня (One Big Thing) -->
                    <div id="star-task-container"></div>
                    
                    <div class="flex justify-between items-center px-1 pt-1">
                        <span class="text-[11px] uppercase tracking-wider opacity-60 font-medium">Все дела</span>
                        <span class="text-[10px] opacity-40">нажми ☆ чтобы сделать главным</span>
                    </div>
                    <div id="tasks-list" class="space-y-3"></div>

                    <!-- Раздел Наград / Списка радостей -->
                    <div class="card p-4 mt-6">
                        <div class="flex justify-between items-center mb-1">
                            <h3 class="text-xs uppercase tracking-wider font-semibold opacity-80">🎁 Копилка наград за сделанные дела</h3>
                            <button onclick="openRewardModal()" class="text-xs font-semibold px-2 py-1 bg-[#311B14] text-[#EDE6D8] rounded-lg shadow-sm">+ Награда</button>
                        </div>
                        <p class="text-[11px] opacity-60 mb-3">Порадуй себя после выполнения дел (сериал, кофе, ванна):</p>
                        <div id="rewards-list" class="space-y-2"></div>
                    </div>
                </div>

                <!-- 2. ПРИВЫЧКИ -->
                <div id="section-habits" class="space-y-3 hidden">
                    <div id="habits-list" class="space-y-3"></div>
                </div>

                <!-- 3. РАСПОРЯДОК ДНЯ -->
                <div id="section-schedule" class="space-y-3 hidden">
                    <div class="flex justify-between items-center px-1 mb-2">
                        <span class="text-[11px] uppercase tracking-wider opacity-60 font-medium">Хронология твоего дня</span>
                        <span class="text-[10px] opacity-40">по времени</span>
                    </div>
                    <div id="schedule-list" class="space-y-3"></div>
                </div>

                <!-- 4. НОВЫЙ РАЗДЕЛ: ТАЙМЕР ФОКУСА ⏱️ -->
                <div id="section-focus" class="space-y-5 hidden">
                    <div class="card p-6 text-center shadow-sm">
                        <!-- Режим таймера -->
                        <div class="flex justify-center gap-2 mb-4">
                            <button id="btn-mode-work" onclick="setTimerMode('work')" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#311B14] text-[#EDE6D8] transition">Фокус</button>
                            <button id="btn-mode-break" onclick="setTimerMode('break')" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#311B14]/10 opacity-70 transition">Отдых</button>
                        </div>

                        <!-- Круговой прогресс таймера -->
                        <div class="timer-circle-wrap my-4 flex items-center justify-center">
                            <svg class="timer-circle-svg" width="160" height="160">
                                <circle class="timer-circle-bg" cx="80" cy="80" r="70"></circle>
                                <circle id="timer-progress" class="timer-circle-progress" cx="80" cy="80" r="70" stroke-dasharray="440" stroke-dashoffset="0"></circle>
                            </svg>
                            <div class="absolute flex flex-col items-center">
                                <span id="timer-display" class="text-3xl font-bold tracking-tight">15:00</span>
                                <span id="timer-status-text" class="text-[10px] uppercase tracking-widest opacity-60 mt-1">правило 5-15 минут</span>
                            </div>
                        </div>

                        <!-- Кнопки управления -->
                        <div class="flex justify-center gap-3 mt-4">
                            <button id="timer-start-btn" onclick="toggleTimer()" class="px-7 py-3 bg-[#311B14] text-[#EDE6D8] rounded-xl text-xs font-semibold tracking-wider active:scale-95 shadow-md">
                                НАЧАТЬ
                            </button>
                            <button onclick="resetTimer()" class="px-4 py-3 bg-[#EDE6D8] border border-[#311B14]/20 rounded-xl text-xs font-medium opacity-70">
                                Сброс
                            </button>
                        </div>

                        <!-- Настройки времени -->
                        <div class="mt-6 pt-5 border-t border-[#311B14]/10 text-left">
                            <span class="text-[10px] uppercase tracking-wider opacity-60 block mb-3 font-semibold text-center">Настрой удобное время под себя:</span>
                            <div class="grid grid-cols-2 gap-3">
                                <div class="bg-[#EDE6D8] p-3 rounded-xl border border-[#311B14]/10">
                                    <label class="block text-[10px] opacity-70 mb-1">Время работы (мин):</label>
                                    <input type="number" id="custom-work-min" value="15" min="1" max="120" onchange="updateTimerSettings()"
                                           class="w-full bg-transparent font-bold text-sm outline-none">
                                </div>
                                <div class="bg-[#EDE6D8] p-3 rounded-xl border border-[#311B14]/10">
                                    <label class="block text-[10px] opacity-70 mb-1">Время отдыха (мин):</label>
                                    <input type="number" id="custom-break-min" value="5" min="1" max="60" onchange="updateTimerSettings()"
                                           class="w-full bg-transparent font-bold text-sm outline-none">
                                </div>
                            </div>
                            <p class="text-[10px] opacity-50 mt-2.5 text-center leading-relaxed">Договорись с собой поработать всего 5–15 минут. Этого достаточно, чтобы мозг включился!</p>
                        </div>
                    </div>
                </div>

                <!-- 5. СОН, МЫСЛИ И НАСТРОЕНИЕ 🌙 -->
                <div id="section-sleep" class="space-y-5 hidden">
                    <div class="card p-4">
                        <div class="flex justify-between items-center mb-1">
                            <h3 class="text-xs uppercase tracking-wider font-semibold opacity-70">Настроение сегодня</h3>
                            <span id="mood-status-label" class="text-[11px] font-medium opacity-60">не выбрано</span>
                        </div>
                        <p class="text-[11px] opacity-60 mb-3">Как ты себя чувствуешь сегодня?</p>
                        
                        <div class="flex justify-between items-center px-1 py-1">
                            <div class="flex flex-col items-center gap-1">
                                <button onclick="setTodayMood('black')" id="mood-btn-black" class="mood-circle bg-[#1A1A1A] border border-[#311B14]/30"></button>
                                <span class="text-[9px] opacity-60">плохо</span>
                            </div>
                            <div class="flex flex-col items-center gap-1">
                                <button onclick="setTodayMood('red')" id="mood-btn-red" class="mood-circle bg-[#D9534F] border border-[#311B14]/20"></button>
                                <span class="text-[9px] opacity-60">пойдет</span>
                            </div>
                            <div class="flex flex-col items-center gap-1">
                                <button onclick="setTodayMood('orange')" id="mood-btn-orange" class="mood-circle bg-[#F0AD4E] border border-[#311B14]/20"></button>
                                <span class="text-[9px] opacity-60">нормально</span>
                            </div>
                            <div class="flex flex-col items-center gap-1">
                                <button onclick="setTodayMood('white')" id="mood-btn-white" class="mood-circle bg-[#FFFFFF] border border-[#311B14]/20"></button>
                                <span class="text-[9px] opacity-60">хорошо</span>
                            </div>
                            <div class="flex flex-col items-center gap-1">
                                <button onclick="setTodayMood('pink')" id="mood-btn-pink" class="mood-circle bg-[#F8BBD0] border border-[#311B14]/20"></button>
                                <span class="text-[9px] opacity-60">отлично</span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-[#311B14]/10">
                            <span class="text-[10px] uppercase tracking-wider opacity-60 block mb-2">История за последние дни:</span>
                            <div id="mood-history-list" class="flex gap-2 overflow-x-auto pb-1"></div>
                        </div>
                    </div>

                    <div class="card p-4">
                        <div class="flex justify-between items-center mb-1">
                            <h3 class="text-xs uppercase tracking-wider font-semibold opacity-70">Дневник ночных мыслей</h3>
                            <span class="text-[10px] opacity-50">архив</span>
                        </div>
                        <p class="text-[11px] opacity-60 mb-2.5 leading-relaxed">Выпиши всё, что в голове, чтобы заснуть со спокойным умом.</p>
                        
                        <textarea id="thought-input" rows="3" 
                                  class="w-full p-3 bg-[#EDE6D8] border border-[#311B14]/10 rounded-xl focus:outline-none text-sm resize-none mb-2.5 placeholder:opacity-40"
                                  placeholder="Что сейчас в мыслях?"></textarea>
                        
                        <button onclick="saveNightThought()" class="w-full py-2.5 bg-[#311B14] text-[#EDE6D8] text-xs font-semibold rounded-xl transition active:scale-98 shadow-sm">
                            ✨ Сохранить мысль в дневник
                        </button>

                        <div class="mt-4 pt-3 border-t border-[#311B14]/10">
                            <span class="text-[10px] uppercase tracking-wider opacity-60 block mb-2">Архив твоих мыслей:</span>
                            <div id="thoughts-archive-list" class="space-y-2 max-h-52 overflow-y-auto pr-1"></div>
                        </div>
                    </div>
                </div>

                <!-- 6. ДОСКА 🤍 (Pinterest) -->
                <div id="section-mood" class="hidden">
                    <div id="mood-empty" class="text-center py-10 opacity-50 text-xs hidden">
                        Твоя доска пока пуста.<br>Нажми кнопку ниже, чтобы загрузить фото или видео из галереи!
                    </div>
                    <div id="images-grid" class="columns-2 gap-3 space-y-3"></div>
                </div>
            </main>
        </div>

        <!-- Кнопка добавления -->
        <div id="add-btn-container" class="fixed bottom-0 left-0 right-0 p-4 bg-[#EDE6D8]/95 backdrop-blur-md max-w-md mx-auto z-40">
            <button onclick="openModal()" class="w-full bg-[#311B14] text-[#EDE6D8] py-4 rounded-2xl shadow-xl active:scale-95 transition-transform font-medium">
                + Добавить запись
            </button>
        </div>
    </div>

    <!-- МОДАЛЬНОЕ ОКНО ДОБАВЛЕНИЯ ЗАПИСЕЙ -->
    <div id="custom-modal" class="hidden fixed inset-0 bg-[#311B14]/40 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-[#F5F0E6] w-full max-w-xs rounded-3xl p-5 border border-[#311B14]/10 shadow-2xl">
            <h3 id="modal-title" class="text-base font-semibold mb-3 tracking-wide text-center">Добавить запись</h3>
            
            <div id="modal-text-group">
                <input type="text" id="modal-input" 
                       class="w-full p-3 bg-[#EDE6D8] border border-[#311B14]/20 rounded-xl focus:outline-none focus:border-[#311B14] mb-3 text-sm" 
                       placeholder="Название...">
            </div>

            <!-- Микро-шаги (подзадачи) для Задач -->
            <div id="modal-subtasks-group" class="mb-3">
                <label class="block text-[10px] uppercase tracking-wider opacity-60 mb-1">Разбить на шаги (через запятую):</label>
                <input type="text" id="modal-subtasks-input" 
                       class="w-full p-2.5 bg-[#EDE6D8] border border-[#311B14]/20 rounded-xl focus:outline-none text-xs text-[#311B14]"
                       placeholder="Открыть тетрадь, пункт 1, вывод">
            </div>

            <div id="modal-target-group" class="mb-3">
                <label class="block text-[10px] uppercase tracking-wider opacity-60 mb-1">Сколько раз нужно выполнить?</label>
                <input type="number" id="modal-target-input" min="1" max="20" value="1"
                       class="w-full p-2.5 bg-[#EDE6D8] border border-[#311B14]/20 rounded-xl focus:outline-none text-xs text-[#311B14]">
            </div>

            <div id="modal-date-group" class="mb-3">
                <label class="block text-[10px] uppercase tracking-wider opacity-60 mb-1">Срок выполнения (необязательно):</label>
                <input type="date" id="modal-date-input" 
                       class="w-full p-2.5 bg-[#EDE6D8] border border-[#311B14]/20 rounded-xl focus:outline-none text-xs text-[#311B14]">
            </div>

            <div id="modal-time-group" class="hidden mb-3">
                <label class="block text-[10px] uppercase tracking-wider opacity-60 mb-1">Время:</label>
                <input type="time" id="modal-time-input" value="08:00"
                       class="w-full p-2.5 bg-[#EDE6D8] border border-[#311B14]/20 rounded-xl focus:outline-none text-xs text-[#311B14]">
            </div>

            <div id="modal-file-group" class="hidden mb-4">
                <label for="media-file-input" class="w-full p-4 border border-dashed border-[#311B14]/30 rounded-2xl flex flex-col items-center justify-center cursor-pointer bg-[#EDE6D8] hover:bg-[#E7DFD0] transition">
                    <span class="text-2xl mb-1">📷</span>
                    <span id="file-label-text" class="text-xs font-medium text-center">Выбрать фото/видео из галереи</span>
                    <span class="text-[9px] opacity-50 mt-1">JPG, PNG, MP4</span>
                </label>
                <input type="file" id="media-file-input" accept="image/*,video/*" class="hidden" onchange="handleFileSelect(event)">
            </div>
            
            <div class="flex justify-end gap-3 text-xs uppercase tracking-wider mt-2">
                <button onclick="closeModal()" class="px-4 py-2 opacity-50 font-semibold">Отмена</button>
                <button onclick="saveModalItem()" class="px-5 py-2 bg-[#311B14] text-[#EDE6D8] rounded-xl font-semibold">ОК</button>
            </div>
        </div>
    </div>

    <!-- МОДАЛЬНОЕ ОКНО ДОБАВЛЕНИЯ НАГРАДЫ -->
    <div id="reward-modal" class="hidden fixed inset-0 bg-[#311B14]/40 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-[#F5F0E6] w-full max-w-xs rounded-3xl p-5 border border-[#311B14]/10 shadow-2xl">
            <h3 class="text-base font-semibold mb-3 tracking-wide text-center">Новая награда</h3>
            <p class="text-[11px] opacity-60 mb-3 text-center">Чем ты себя порадуешь за выполненные дела?</p>
            <input type="text" id="reward-input" 
                   class="w-full p-3 bg-[#EDE6D8] border border-[#311B14]/20 rounded-xl focus:outline-none text-sm mb-4" 
                   placeholder="Например: Вкусный десерт">
            <div class="flex justify-end gap-3 text-xs uppercase tracking-wider">
                <button onclick="closeRewardModal()" class="px-4 py-2 opacity-50 font-semibold">Отмена</button>
                <button onclick="saveRewardItem()" class="px-5 py-2 bg-[#311B14] text-[#EDE6D8] rounded-xl font-semibold">ОК</button>
            </div>
        </div>
    </div>

    <script>
        // IndexedDB для медиа (Галерея)
        let db;
        const request = indexedDB.open("ToutEstDevantSoiDB", 1);
        request.onupgradeneeded = (e) => {
            const database = e.target.result;
            if (!database.objectStoreNames.contains("media")) {
                database.createObjectStore("media", { keyPath: "id", autoIncrement: true });
            }
        };
        request.onsuccess = (e) => {
            db = e.target.result;
            loadMediaFromDB();
        };

        // Состояние
        let state = {
            activeTab: 'tasks',
            starTaskId: localStorage.getItem('starTaskId') || null, // Главная победа дня
            tasks: JSON.parse(localStorage.getItem('tasks')) || [],
            habits: JSON.parse(localStorage.getItem('habits')) || [],
            schedule: JSON.parse(localStorage.getItem('schedule')) || [
                { time: "07:30", text: "Подъем и стакан воды", done: false },
                { time: "08:00", text: "Утренняя рутина / завтрак", done: false },
                { time: "22:30", text: "Подготовка ко сну и отдых", done: false }
            ],
            rewards: JSON.parse(localStorage.getItem('rewards')) || [
                { text: "Посмотреть серию любимого сериала", claimed: false },
                { text: "Вкусный кофе или чай с десертом", claimed: false }
            ],
            moodHistory: JSON.parse(localStorage.getItem('moodHistory')) || {},
            thoughtsList: JSON.parse(localStorage.getItem('thoughtsList')) || [],
            mediaList: []
        };

        let selectedMediaBase64 = null;
        let selectedMediaType = null;

        function getTodayString() {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }

        function renderDate() {
            const options = { weekday: 'long', day: 'numeric', month: 'long' };
            let dateStr = new Date().toLocaleDateString('ru-RU', options);
            document.getElementById('current-date').innerText = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
        }

        function saveData() {
            localStorage.setItem('tasks', JSON.stringify(state.tasks));
            localStorage.setItem('habits', JSON.stringify(state.habits));
            localStorage.setItem('schedule', JSON.stringify(state.schedule));
            localStorage.setItem('rewards', JSON.stringify(state.rewards));
            localStorage.setItem('moodHistory', JSON.stringify(state.moodHistory));
            localStorage.setItem('thoughtsList', JSON.stringify(state.thoughtsList));
