        function saveModalItem() {
            const val = document.getElementById('modal-input').value.trim();
            const subtasksRaw = document.getElementById('modal-subtasks-input').value.trim();
            const targetVal = parseInt(document.getElementById('modal-target-input').value, 10) || 1;
            const dueDateVal = document.getElementById('modal-date-input').value;
            const timeVal = document.getElementById('modal-time-input').value;

            if (state.activeTab === 'tasks') {
                if (val) {
                    let subtasks = [];
                    if (subtasksRaw) {
                        subtasks = subtasksRaw.split(',').map(s => s.trim()).filter(s => s.length > 0).map(s => ({ text: s, done: false }));
                    }

                    state.tasks.push({ 
                        id: 'task_' + Date.now(),
                        text: val, 
                        targetCount: targetVal, 
                        currentCount: 0, 
                        done: false, 
                        dueDate: dueDateVal || null,
                        subtasks: subtasks
                    });
                }
                saveData();
                render();
            } else if (state.activeTab === 'habits') {
                if (val) {
                    state.habits.push({ 
                        text: val, 
                        targetCount: targetVal, 
                        todayCount: 0, 
                        streak: 0, 
                        lastCompletedDate: "" 
                    });
                }
                saveData();
                render();
            } else if (state.activeTab === 'schedule') {
                if (val) {
                    state.schedule.push({ time: timeVal, text: val, done: false });
                    state.schedule.sort((a, b) => a.time.localeCompare(b.time));
                }
                saveData();
                render();
            } else if (state.activeTab === 'mood') {
                if (selectedMediaBase64 && db) {
                    const tx = db.transaction("media", "readwrite");
                    const store = tx.objectStore("media");
                    store.add({
                        type: selectedMediaType,
                        data: selectedMediaBase64,
                        createdAt: new Date().getTime()
                    });
                    tx.oncomplete = () => { loadMediaFromDB(); };
                }
            }
            closeModal();
        }

        function loadMediaFromDB() {
            if (!db) return;
            const tx = db.transaction("media", "readonly");
            const store = tx.objectStore("media");
            const getAll = store.getAll();
            getAll.onsuccess = () => {
                state.mediaList = getAll.result.reverse();
                renderMedia();
            };
        }

