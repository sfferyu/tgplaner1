                            </div>

                            <button onclick="toggleStarTask('${t.id}')" class="text-sm px-1.5 opacity-60 hover:opacity-100" title="Сделать главной победой дня">
                                ${isStar ? '⭐️' : '☆'}
                            </button>
                            <button onclick="deleteItem('tasks', ${i})" class="text-xs opacity-25 p-1 ml-1">✕</button>
                        </div>

                        ${t.subtasks && t.subtasks.length > 0 ? `
                            <div class="mt-2.5 pt-2 border-t border-[#311B14]/10 space-y-1.5 pl-6">
                                ${t.subtasks.map((sub, sIdx) => `
                                    <div class="flex items-center gap-2">
                                        <input type="checkbox" ${sub.done ? 'checked' : ''} onchange="toggleSubtask(${i}, ${sIdx})" class="sub-checkbox">
                                        <span class="text-xs ${sub.done ? 'line-through opacity-40' : ''}">${sub.text}</span>
                                    </div>
                                `).join('')}
                            </div>
                        ` : ''}
                    </div>
                `;
            }).join('');

            // 2. ПРИВЫЧКИ
            const habitsList = document.getElementById('habits-list');
            habitsList.innerHTML = state.habits.map((h, i) => {
                const target = h.targetCount || 1;
                const isToday = (h.lastCompletedDate === today);
                const current = isToday ? (h.todayCount || 0) : 0;
                const isCompleted = current >= target;
                const isMulti = target > 1;

                return `
                    <div class="card flex justify-between items-center p-4 shadow-sm">
                        <div class="flex items-center">
                            ${isMulti ? `
                                <button onclick="incrementHabitCount(${i})" class="counter-pill ${isCompleted ? 'opacity-40' : ''}">
                                    ${current}/${target}
                                </button>
                            ` : `
                                <input type="checkbox" ${isCompleted ? 'checked' : ''} onchange="incrementHabitCount(${i})" class="custom-checkbox">
                            `}
                            
                            <div class="ml-3.5 cursor-pointer" onclick="incrementHabitCount(${i})">
                                <p class="font-medium text-sm ${isCompleted ? 'line-through opacity-40' : ''}">${h.text}</p>
                                <p class="text-[10px] uppercase tracking-wider opacity-60 mt-0.5">Серия: ${h.streak} 🔥</p>
                            </div>
                        </div>
                        <button onclick="deleteItem('habits', ${i})" class="text-xs opacity-25 p-1">✕</button>
                    </div>
                `;
            }).join('');

            // 3. РАСПОРЯДОК ДНЯ
            const scheduleList = document.getElementById('schedule-list');
            scheduleList.innerHTML = state.schedule.map((s, i) => `
                <div class="card flex items-center p-3.5 shadow-sm">
                    <div class="text-xs font-semibold px-2 py-1 bg-[#EDE6D8] rounded-lg border border-[#311B14]/10 shrink-0">
                        ${s.time}
                    </div>
                    <div class="ml-3 flex-grow text-sm ${s.done ? 'line-through opacity-40' : ''} cursor-pointer" onclick="toggleScheduleItem(${i})">
                        ${s.text}
                    </div>
                    <input type="checkbox" ${s.done ? 'checked' : ''} onchange="toggleScheduleItem(${i})" class="custom-checkbox ml-2">
                    <button onclick="deleteItem('schedule', ${i})" class="text-xs opacity-25 p-1 ml-2">✕</button>
                </div>
            `).join('');

            // 4. ПРОГРЕСС-БАР ДНЯ
            const totalItems = state.tasks.length + state.schedule.length;
            const completedItems = state.tasks.filter(t => t.done).length + state.schedule.filter(s => s.done).length;
            const percent = totalItems > 0 ? Math.round((completedItems / totalItems) * 100) : 0;
            
            document.getElementById('progress-percent').innerText = `${percent}%`;
            document.getElementById('progress-bar').style.width = `${percent}%`;

            renderRewards();
            renderMoodTracker();
            renderThoughtsArchive();
            renderMedia();
        }

        renderDate();
        render();
        updateTimerDisplay();

        if (window.Telegram && window.Telegram.WebApp) {
            const tg = window.Telegram.WebApp;
            tg.expand();
            tg.ready();
        }
    </script>
</body>
</html>
